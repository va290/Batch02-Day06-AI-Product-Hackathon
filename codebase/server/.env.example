# Sao chép thành .env rồi điền. KHÔNG commit .env.
# Dùng LLM tùy biến OpenAI-compatible giống Day04 (provider 'custom').
# Có thể tái dùng đúng giá trị từ .env của Day04.
CUSTOM_BASE_URL=https://your-gateway/v1
CUSTOM_API_KEY=<put-your-key-here>
CUSTOM_MODEL=your-model-name
# CUSTOM_TEMPERATURE=0   # một số model (extended-thinking) cần =1
